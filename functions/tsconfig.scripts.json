{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "rootDir": "scripts",
    "outDir": "lib-scripts",
    "sourceMap": true,
    "strict": true,
    "target": "es2017"
  },
  "include": [
    "scripts"
  ]
}
