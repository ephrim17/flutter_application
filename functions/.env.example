SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=Church App mirhpe17@gmail.com
YOUTUBE_WEBHOOK_CALLBACK_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net/youtubeLiveWebhook
# Max "Generate with AI" verse-card actions per user per Asia/Kolkata day — each
# action still returns up to 3 candidates. Product policy: strictly 1/day
# in production. Not a secret. GEMINI_API_KEY itself is a secret — set it
# with `firebase functions:secrets:set GEMINI_API_KEY`, never here.
AI_IMAGE_DAILY_CAP=1
# Generation batches a single CHURCH may start per Asia/Kolkata day for its
# shared Daily Verse cards — not per user. Generation is admin-driven from
# Studio and one press does both languages (2 batches), so 4 leaves room for
# one full redo after an admin corrects the verse.
DAILY_VERSE_CARD_DAILY_CAP=4
# Bible AI-summary actions per user per UTC day. Product policy: strictly
# 1 chapter summary and 5 verse summaries per day in production.
BIBLE_CHAPTER_SUMMARY_DAILY_CAP=1
BIBLE_VERSE_SUMMARY_DAILY_CAP=5
