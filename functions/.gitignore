# Compiled JavaScript files
lib/**/*.js
lib/**/*.js.map
lib-scripts/**/*.js
lib-scripts/**/*.js.map

# TypeScript v1 declaration files
typings/

# Node.js dependency directory
node_modules/
*.local
.env
.env.*
!.env.example

# Service account keys (GOOGLE_APPLICATION_CREDENTIALS for local scripts) —
# never commit these, wherever they land.
*serviceAccount*.json
*service-account*.json
*adminsdk*.json
*firebase-adminsdk*.json

# Migration harness run reports/conflict CSVs — local artifacts, not
# something to check in.
/migration-reports/
