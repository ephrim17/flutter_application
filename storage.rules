rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /bible/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /churches/{churchId}/feed/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /churches/{churchId}/equipments/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /churches/global/feeds/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /churches/{churchId}/announcements/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /churches/{churchId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
