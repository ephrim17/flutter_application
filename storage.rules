rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Mirrors churches/{churchId}/config/app.admins in firestore.rules —
    // Storage rules can read Firestore data via the firestore.* functions.
    function isChurchAdmin(churchId) {
      return isSignedIn() &&
        request.auth.token.email.lower() in
          firestore.get(/databases/(default)/documents/churches/$(churchId)/config/app).data.admins;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/superAdmins/$(request.auth.token.email.lower())) &&
        firestore.get(/databases/(default)/documents/superAdmins/$(request.auth.token.email.lower())).data.enabled == true;
    }

    function isChurchStaff(churchId) {
      return isChurchAdmin(churchId) || isSuperAdmin();
    }

    // Mirrors firestore.rules' hasVerifiedEmail() — `.get(key, default)`,
    // not dot-access, since a doc that predates the field would otherwise
    // throw and fail the whole rule closed (see the migration doc's
    // real-bug addendum on the Firestore-side version of this mistake).
    function hasVerifiedEmail() {
      return isSignedIn() &&
        (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
           .data.get('emailVerified', true) != false);
    }

    // A churchId with no Firestore doc yet is still being registered —
    // `SuperAdminChurchService.createChurch` uploads the logo/pastor photo
    // *before* writing any Firestore doc for it (super-admin and public
    // self-registration both), so at upload time `isChurchStaff(churchId)`
    // can never be true yet for a public registrant (there is no
    // config/app.admins to be listed in, and they are not the super admin).
    // Once the church doc exists, this always reads false and
    // `isChurchStaff` alone governs further writes.
    function isUnclaimedChurch(churchId) {
      return !firestore.exists(/databases/(default)/documents/churches/$(churchId));
    }

    match /bible/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Avatar blob for the person, not the membership — church-independent
    // (§4.1, §5.1).
    match /users/{uid}/profile/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid);
    }

    match /churches/{churchId}/feed/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Multi-image gallery uploads (feed_repository.dart's createPost) use
    // this plural "feeds" path, scoped per church id — "global" for posts
    // in the cross-church feed.
    match /churches/{churchId}/feeds/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /churches/{churchId}/announcements/{fileName} {
      allow read: if true;
      allow write: if isChurchStaff(churchId);
    }

    match /churches/{churchId}/pastorPhotos/{fileName} {
      allow read: if isSignedIn();
      allow write: if isChurchStaff(churchId) ||
        (hasVerifiedEmail() && isUnclaimedChurch(churchId));
    }

    match /churches/{churchId}/logo {
      allow read: if true;
      allow write: if isChurchStaff(churchId) ||
        (hasVerifiedEmail() && isUnclaimedChurch(churchId));
    }

    match /churches/{churchId}/equipments/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isChurchStaff(churchId);
    }

    match /churches/{churchId}/learning_modules/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /churches/global/learning_modules/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // No broad catch-all — anything not matched above is denied by default.
  }
}
