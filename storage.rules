rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Mirrors churches/{churchId}/config/app.admins in firestore.rules —
    // Storage rules can read Firestore data via the firestore.* functions.
    function isChurchAdmin(churchId) {
      return isSignedIn() &&
        request.auth.token.email.lower() in
          firestore.get(/databases/(default)/documents/churches/$(churchId)/config/app).data.admins;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/superAdmins/$(request.auth.token.email.lower())) &&
        firestore.get(/databases/(default)/documents/superAdmins/$(request.auth.token.email.lower())).data.enabled == true;
    }

    function isChurchStaff(churchId) {
      return isChurchAdmin(churchId) || isSuperAdmin();
    }

    match /bible/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /churches/{churchId}/users/{uid}/profile/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid) || isChurchStaff(churchId);
    }

    match /churches/{churchId}/feed/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /churches/global/feeds/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /churches/{churchId}/announcements/{fileName} {
      allow read: if true;
      allow write: if isChurchStaff(churchId);
    }

    match /churches/{churchId}/pastorPhotos/{fileName} {
      allow read: if isSignedIn();
      allow write: if isChurchStaff(churchId);
    }

    match /churches/{churchId}/logo {
      allow read: if true;
      allow write: if isChurchStaff(churchId);
    }

    match /churches/{churchId}/equipments/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isChurchStaff(churchId);
    }

    match /churches/{churchId}/learning_modules/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /churches/global/learning_modules/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // No broad catch-all — anything not matched above is denied by default.
  }
}
